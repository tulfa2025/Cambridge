# Cambridge Configurator - static hosting (Apache). Safe to leave if the host ignores it.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/ktx2 .ktx2
  AddType application/wasm .wasm
  AddType application/javascript .js
  AddType image/webp .webp
  AddType image/vnd.radiance .hdr
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml model/gltf-binary application/wasm image/vnd.radiance
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(glb|ktx2|wasm|jpg|png|webp|svg|hdr)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
